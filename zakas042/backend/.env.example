# ============================================================
#  Imron Hotel PMS — muhit o'zgaruvchilari
#  Nusxa oling:  cp .env.example .env
# ============================================================

# --- Database -----------------------------------------------
DATABASE_URL="postgresql://imron:imron@localhost:5432/imron_pms?schema=public"

# --- Redis (BullMQ, TZ 11-band) -----------------------------
REDIS_URL="redis://localhost:6379"

# --- Server -------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Xavfsizlik (TZ 18-band) --------------------------------
# 32 bayt hex — yaratish:  openssl rand -hex 32
ENCRYPTION_KEY=""
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# --- Beds24 (TZ 13-band: frontendga chiqmaydi) --------------
# Test:       http://localhost:4000        (mock server)
# Production: https://api.beds24.com/v2
BEDS24_BASE_URL="http://localhost:4000"
BEDS24_CREDIT_LIMIT=100
BEDS24_CREDIT_SAFETY_THRESHOLD=10

# --- Webhook validatsiyasi (04 §9) --------------------------
# signature | ip_token
WEBHOOK_AUTH_MODE="ip_token"
WEBHOOK_URL_TOKEN=""
WEBHOOK_SIGNATURE_SECRET=""
WEBHOOK_ALLOWED_IPS=""

# --- Source of truth (TZ 7-band) ----------------------------
SOURCE_OF_TRUTH_RATES="pms"
SOURCE_OF_TRUTH_AVAILABILITY="pms"

# --- Biznes qoidalari ---------------------------------------
PENDING_PAYMENT_TIMEOUT_HOURS=24
POLL_INTERVAL_MINUTES=15

# --- Xavfsizlik (TZ 18-band, FAZA 12) -----------------------
# PRODUCTION'DA MAJBURIY "true" — JWT barcha /api/* da talab qilinadi.
# Dev'da "false": Shaxmatka hozircha login ekranisiz ishlaydi.
AUTH_REQUIRED="false"

# Rate limiting. Testlarda "true" (o'chirilgan): testlar o'nlab
# so'rov yuboradi va cheklovga urilib qolishi mumkin.
# PRODUCTION'DA "false" — cheklov yoqilgan bo'lishi kerak.
RATE_LIMIT_DISABLED="false"

# CORS — ruxsat etilgan domenlar (vergul bilan).
# Bo'sh bo'lsa faqat bir xil origin ishlaydi. Frontend
# backendning o'zidan xizmat qilingani uchun odatda bo'sh
# qoladi. Sayt alohida domenda bo'lsa shu yerga yoziladi:
#   CORS_ORIGINS="https://imron-hotel.uz"
CORS_ORIGINS=""

# Beds24 room type ro'yxati keshi, millisekund (03-fayl §8, 06-fayl §3).
# Standart 600000 (10 daqiqa). Testlarda 0 qo'yiladi: mock holati
# tez-tez tozalanadi va kesh eski javobni qaytarib turardi.
PROPERTY_CACHE_TTL_MS=600000

# --- Telegram bot (founder uchun) ---------------------------
# Token: @BotFather -> /newbot
# Bo'sh bo'lsa bot ishga tushmaydi, backend normal ishlaydi.
TELEGRAM_BOT_TOKEN=""

# Kim kira oladi. O'z ID'ingizni bilish: botga /id yozing,
# yoki @userinfobot ga /start.
# Vergul bilan bir nechta: "123456789,987654321"
TELEGRAM_FOUNDER_IDS=""

# Yangi bron kelganda avtomatik xabar yuborilsinmi
TELEGRAM_NOTIFY_BOOKINGS="true"

# --- 2-bot: Tozalik -----------------------------------------
TELEGRAM_CLEANING_BOT_TOKEN=""
TELEGRAM_CLEANING_GROUP_ID=""

# --- 3-bot: Oshxona -----------------------------------------
TELEGRAM_KITCHEN_BOT_TOKEN=""
TELEGRAM_KITCHEN_CHAT_ID=""

